/**
 * Прозвища: как человек записан в таблице эфиров или в отчёте ЗКФ → кто это в чате.
 * Второй файл в том же проекте Apps Script, рядом с live.gs. Файл с настоящими
 * прозвищами лежит только у вас: private/aliases.gs. В репозитории — этот шаблон.
 *
 * Слева: как записано (регистр и ё не важны). Справа: '@ник_в_telegram'
 * или другое имя, по которому человек уже находится. Пустая строка — пропустить.
 * После правки: сохранить, запустить debugLive, обновить развёртывание.
 */
var ALIASES = {
  'зайка с эфира': '@nick_v_telegram',
  'маша п': 'мария петрова',
  'не та маша': '-'          // '-' = забыть
};

// Кого убрать с площадки совсем.
var EXCLUDE = ['@nick_kogo_ubrat'];

// Ручные ники: '@ник_telegram' → ник из списков POOLS в live.gs.
var NICKS = {
  '@nick_v_telegram': 'Паулетта'
};

// Фамилии и имена, которых нет в таблицах, но которые нельзя показывать во фразах.
var HIDE = ['фамилия1', 'фамилия2'];

// Закреплённые фразы: всегда звучат у этого человечка. Фильтр имён и личного действует.
var PINNED = {
  '@nick_v_telegram': ['Фраза, которая обязательно должна звучать.']
};

// Один человек под двумя никами Telegram: '@старый': '@новый'.
var MERGE = {};
